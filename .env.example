# Microsoft / Outlook SMTP Zugangsdaten
SMTP_USER=dein.name@dein-unternehmen.de
SMTP_PASSWORD=dein-passwort-oder-app-passwort
SENDER_NAME=Vorname Nachname

# Standard fuer Microsoft 365 Business
SMTP_HOST=smtp.office365.com
SMTP_PORT=587

# Fuer private Outlook.com / Hotmail Accounts stattdessen:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
